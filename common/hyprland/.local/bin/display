#!/usr/bin/env python3
"""What each external screen does: extend, mirror (the laptop screen) or off.

The screens are declared in the host's host.lua (see ~/.config/hypr/conf/display.lua),
which also applies the modes. This script only stores the choice per connector in
~/.local/state/display/modes and asks Hyprland to apply it again.

Usage: display [menu | status | set <output> <mode> | toggle]
  menu     pick a screen, then its mode, with rofi (default, SUPER+P)
  status   JSON for the status bar
  set      e.g. `display set HDMI-A-1 mirror`
  toggle   switch every connected screen between mirror and extend
"""
import json
import os
import subprocess
import sys
from pathlib import Path

STATE = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "display" / "modes"
MODES = ["extend", "mirror", "off"]
NAMES = {"extend": "Extend", "mirror": "Mirror", "off": "Off"}
MARK = {True: "󰐾", False: "󰐽"}  # radio on / off
WATRIX_RESET = Path.home() / ".config/hypr/scripts/watrix-reset.fish"

# rofi row states: -a (current) in the accent color, -u (not connected) greyed out.
# The theme's `* { text-color }` reaches element-text directly; inherit the
# element's color instead so those states show.
ROFI_THEME = (
    "element-text { text-color: inherit; } "
    "element normal.active, element alternate.active { text-color: @accent; } "
    "element selected.active { background-color: @surface; text-color: @accent; } "
    "element normal.urgent, element alternate.urgent { text-color: @overlay; } "
    "element selected.urgent { background-color: @surface; text-color: @overlay; }"
)


def hyprctl(*args):
    return subprocess.run(["hyprctl", *args], capture_output=True, text=True).stdout


def screens():
    """The external screens host.lua declared, in its order, with their mode."""
    out = hyprctl("repl", 'return require("conf.display").list()')
    connected = {m["name"] for m in json.loads(hyprctl("-j", "monitors", "all") or "[]")}
    result = []
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) == 3:
            name, label, mode = parts
            result.append({"name": name, "label": label, "mode": mode, "connected": name in connected})
    return result


def save(changes, old):
    """Store and apply new modes; old is {output: mode} from before."""
    saved = {}
    if STATE.exists():
        for line in STATE.read_text().splitlines():
            parts = line.split()
            if len(parts) == 2:
                saved[parts[0]] = parts[1]
    saved.update(changes)
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text("".join(f"{k} {v}\n" for k, v in sorted(saved.items())))
    hyprctl("eval", 'require("conf.display").apply()')
    # Turning a screen on or off is a monitor added/removed event, which already
    # resets watrix (conf/exec.lua). Mirroring fires no event: the mirrored
    # screen's workspaces land on the laptop outside the grid, so reset here.
    if any("mirror" in (mode, old.get(name)) for name, mode in changes.items()):
        subprocess.run([str(WATRIX_RESET)], capture_output=True)


def set_mode(name, mode):
    screen = next((s for s in screens() if s["name"] == name), None)
    if screen is None:
        sys.exit(f"display: {name} is not declared in host.lua")
    if mode not in MODES:
        sys.exit(f"display: mode is one of {', '.join(MODES)}")
    if mode != screen["mode"]:
        save({name: mode}, {name: screen["mode"]})


def toggle():
    connected = [s for s in screens() if s["connected"]]
    if not connected:
        return
    mode = "mirror" if any(s["mode"] == "extend" for s in connected) else "extend"
    save({s["name"]: mode for s in connected}, {s["name"]: s["mode"] for s in connected})


def rofi(prompt, rows, current=(), grey=(), selected=0):
    """Pick a row; returns its index or None (Escape)."""
    out = subprocess.run(
        ["rofi", "-dmenu", "-i", "-p", prompt, "-no-custom", "-format", "i",
         "-selected-row", str(selected),
         "-a", ",".join(map(str, current)), "-u", ",".join(map(str, grey)),
         "-theme-str", f"listview {{ lines: {len(rows)}; }} " + ROFI_THEME],
        input="\n".join(rows), capture_output=True, text=True,
    ).stdout.strip()
    return int(out) if out.isdigit() else None


def menu():
    """Screen first, then its mode. Escape in the mode list goes back to the screens.
    A screen that isn't connected can be highlighted but not opened."""
    selected = 0
    while True:
        all_screens = screens()
        if not all_screens:
            sys.exit("display: no external screens declared in host.lua")
        rows = [f"󰍹  {s['label']:<8} {s['name']:<10} {NAMES[s['mode']] if s['connected'] else 'not connected'}"
                for s in all_screens]
        grey = [i for i, s in enumerate(all_screens) if not s["connected"]]
        picked = rofi("display", rows, grey=grey, selected=selected)
        if picked is None:
            return
        selected = picked
        screen = all_screens[picked]
        if not screen["connected"]:
            continue

        rows = [f"{MARK[screen['mode'] == m]}  {NAMES[m]}" for m in MODES]
        current = [MODES.index(screen["mode"])]
        mode = rofi(screen["label"], rows, current=current)
        if mode is not None:
            set_mode(screen["name"], MODES[mode])
            return


def main():
    args = sys.argv[1:] or ["menu"]
    cmd = args[0]
    if cmd == "menu":
        menu()
    elif cmd == "status":
        print(json.dumps(screens()))
    elif cmd == "set" and len(args) == 3:
        set_mode(args[1], args[2])
    elif cmd == "toggle":
        toggle()
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
