# Host specific config and secrets go in conf.d/*.fish, which fish loads
# automatically before this file (see hosts/<host>/... and .gitignore).

fish_add_path ~/.local/bin

# eza colors, generated by ~/.local/bin/theme
set -gx EZA_CONFIG_DIR (set -q XDG_STATE_HOME; and echo $XDG_STATE_HOME; or echo ~/.local/state)/theme/current/eza

if status is-interactive
    set fish_greeting
    abbr -a wlc wl-copy
end
