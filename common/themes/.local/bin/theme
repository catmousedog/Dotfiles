#!/usr/bin/env python3
"""Generate and switch the desktop color theme.

The single source of truth is ~/.config/themes/palettes/<theme>-<dark|light>.json:
the theme's own colors under their own names, plus "roles" saying which of them
each part of the desktop uses (see ROLES). Everything below only uses roles, so
a theme decides its own look. This script renders the roles into every format
the desktop needs and writes the result to $XDG_STATE_HOME/theme/current/,
which the configs read from:

    colors.json    quickshell (watched, reloads by itself)
    colors.rasi    rofi
    colors.css     GTK-style @define-color
    kitty.conf     kitty (reloaded with SIGUSR1)
    hypr.lua       hyprland (reloaded with hyprctl reload)
    hyprlock.conf  hyprlock ($name / $nameAlpha variables)
    wallpaper      link to the current wallpaper
    dunst.conf     dunst, linked as ~/.config/dunst/dunstrc.d/90-theme.conf
    eza/theme.yml  eza (EZA_CONFIG_DIR points here, see config.fish)
    yazi.toml      yazi, linked as ~/.config/yazi/theme.toml (read on start)

Some programs can't read from another location, so their files are written
directly (they aren't in the repo, edit this script instead):

    ~/.local/share/icons/Theme-<flavor>/   Adwaita with folders in the accent color
    ~/.local/share/themes/Theme-<flavor>/  GTK 3 theme: adw-gtk3 recolored. GTK apps
                                           (Thunar, file dialogs) restyle live when
                                           the gtk-theme setting switches to it

Every theme (catppuccin, rose-pine) has a dark and a light palette.
`theme toggle` (SUPER+T) switches between the two, `theme menu` (SUPER+SHIFT+T)
picks another theme with rofi and keeps the current mode.

Wallpaper: ~/.config/backgrounds/<theme>-<dark|light>.*, else <theme>.*, else
background.*; `theme wallpaper` sets it (Hyprland runs that at startup).

VS Code gets its color theme written straight into settings.json; its own
"follow the system theme" option doesn't work reliably here. A git clean
filter (`theme vscode-clean`, set up by the Makefile) keeps that line at the
default in the repo, so toggling doesn't leave settings.json modified.

Usage: theme [init | toggle | menu | wallpaper | current | list | <theme> | <theme>-<dark|light> | vscode-clean]
"""

import colorsys
import json
import re
import os
import shutil
import subprocess
import sys
from pathlib import Path

# resolved via the script itself so it also works straight from the repo, before stowing
PALETTES = Path(__file__).resolve().parents[2] / ".config/themes/palettes"
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "theme"
CURRENT = STATE / "current"
FLAVOR_FILE = STATE / "flavor"
DEFAULT = "catppuccin-dark"
MODES = ("dark", "light")
SWATCHES = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "theme/swatches"

VSCODE_SETTINGS = CONFIG / "Code - OSS/User/settings.json"
DUNST_DROPIN = CONFIG / "dunst/dunstrc.d/90-theme.conf"
YAZI_THEME = CONFIG / "yazi/theme.toml"
DATA = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
ADW_GTK3 = Path("/usr/share/themes")  # adw-gtk3 and adw-gtk3-dark, from adw-gtk-theme
ADWAITA_PLACES = Path("/usr/share/icons/Adwaita/scalable/places")
ADWAITA_FOLDER = "#62a0ea"  # main color of Adwaita's folder icons
HEX = re.compile(r"#[0-9a-fA-F]{6}\b")
BACKGROUNDS = CONFIG / "backgrounds"
# from the Catppuccin extension; other palettes fall back to Mocha / Latte
# labels of installed VS Code themes (Catppuccin, Pastel, Rosé Pine extensions)
VSCODE_THEMES = {"catppuccin-dark": "Catppuccin Mocha", "catppuccin-light": "Catppuccin Latte",
                 "rose-pine-dark": "Pastel - Theme", "rose-pine-light": "Rosé Pine Dawn"}
VSCODE_KEY = re.compile(r'("workbench\.colorTheme"\s*:\s*)"[^"]*"')


ROLES = {
    "bg": "main background",
    "bg_alt": "panels, sidebars, inactive tabs",
    "bg_deep": "the darkest (light: lightest-but-one) background, e.g. the tab bar",
    "surface": "raised elements, hovered rows",
    "surface_alt": "borders, selected rows",
    "surface_hi": "strong borders",
    "overlay": "hints, punctuation, inactive things",
    "muted": "secondary details",
    "subtle": "secondary text",
    "fg": "text",
    "accent": "main highlight: active borders, selection, folders",
    "accent2": "second highlight: start of the border gradient",
    "red": "errors", "orange": "", "yellow": "warnings", "green": "success",
    "cyan": "", "blue": "", "purple": "", "pink": "",
}


def load(flavor):
    """The palette's roles as a {role: "#rrggbb"} dict."""
    palette = json.loads((PALETTES / f"{flavor}.json").read_text())
    colors = palette["colors"]
    roles = {}
    for role in ROLES:
        value = palette["roles"][role]
        roles[role] = value if value.startswith("#") else colors[value]
    return roles


def is_dark(p):
    r, g, b = (int(p["bg"][i:i + 2], 16) for i in (1, 3, 5))
    return (0.299 * r + 0.587 * g + 0.114 * b) < 128


def kitty(p):
    dark = is_dark(p)
    lines = {
        "foreground": p["fg"],
        "background": p["bg"],
        "selection_foreground": p["bg"],
        "selection_background": p["accent"],
        "cursor": p["fg"],
        "cursor_text_color": p["bg"],
        "url_color": p["accent"],
        "active_border_color": p["accent"],
        "inactive_border_color": p["overlay"],
        "bell_border_color": p["yellow"],
        "wayland_titlebar_color": "system",
        "active_tab_foreground": p["bg"],
        "active_tab_background": p["accent"],
        "inactive_tab_foreground": p["fg"],
        "inactive_tab_background": p["bg_alt"] if dark else p["surface_alt"],
        "tab_bar_background": p["bg_deep"] if dark else p["surface"],
        "mark1_foreground": p["bg"],
        "mark1_background": p["accent"],
        "mark2_foreground": p["bg"],
        "mark2_background": p["purple"],
        "mark3_foreground": p["bg"],
        "mark3_background": p["blue"],
        # black / white slots swap roles between dark and light flavors
        "color0": p["surface_alt"] if dark else p["subtle"],
        "color8": p["surface_hi"] if dark else p["muted"],
        "color7": p["subtle"] if dark else p["surface_hi"],
        "color15": p["fg"] if dark else p["surface_alt"],
    }
    for normal, bright, name in [(1, 9, "red"), (2, 10, "green"), (3, 11, "yellow"),
                                 (4, 12, "blue"), (5, 13, "purple"), (6, 14, "cyan")]:
        lines[f"color{normal}"] = lines[f"color{bright}"] = p[name]
    return "".join(f"{k} {v}\n" for k, v in lines.items())


def dunst(p):
    def urgency(name, fg, frame, highlight):
        return (f"[urgency_{name}]\n    background = \"{p['bg']}\"\n    foreground = \"{fg}\"\n"
                f"    frame_color = \"{frame}\"\n    highlight = \"{highlight}\"\n")
    # the progress bar uses the same gradient as the bar's borders
    return (urgency("low", p["subtle"], p["overlay"], p["muted"])
            + urgency("normal", p["fg"], p["accent"], f"{p['accent2']}, {p['accent']}")
            + urgency("critical", p["fg"], p["red"], p["red"]))


def eza(p):
    def c(color, bold=False):
        return "{foreground: \"%s\"%s}" % (p[color], ", is_bold: true" if bold else "")
    sections = {
        "filekinds": {"normal": c("fg"), "directory": c("accent", True), "symlink": c("cyan"),
                      "pipe": c("muted"), "block_device": c("orange"), "char_device": c("orange"),
                      "socket": c("muted"), "special": c("pink"), "executable": c("green", True),
                      "mount_point": c("blue", True)},
        "perms": {"user_read": c("yellow"), "user_write": c("red"), "user_execute_file": c("green"),
                  "user_execute_other": c("green"), "group_read": c("yellow"), "group_write": c("red"),
                  "group_execute": c("green"), "other_read": c("yellow"), "other_write": c("red"),
                  "other_execute": c("green"), "special_user_file": c("purple"),
                  "special_other": c("muted"), "attribute": c("muted")},
        "size": {"major": c("subtle"), "minor": c("blue"), "number_byte": c("fg"),
                 "number_kilo": c("fg"), "number_mega": c("blue"), "number_giga": c("purple"),
                 "number_huge": c("red"), "unit_byte": c("muted"), "unit_kilo": c("muted"),
                 "unit_mega": c("muted"), "unit_giga": c("muted"), "unit_huge": c("muted")},
        "users": {"user_you": c("fg"), "user_root": c("red"), "user_other": c("purple"),
                  "group_yours": c("subtle"), "group_other": c("muted"), "group_root": c("red")},
        "links": {"normal": c("cyan"), "multi_link_file": c("cyan", True)},
        "git": {"new": c("green"), "modified": c("yellow"), "deleted": c("red"), "renamed": c("cyan"),
                "typechange": c("pink"), "ignored": c("overlay"), "conflicted": c("red")},
        "git_repo": {"branch_main": c("fg"), "branch_other": c("purple"), "git_clean": c("green"),
                     "git_dirty": c("red")},
        "file_type": {"image": c("yellow"), "video": c("red"), "music": c("green"),
                      "lossless": c("cyan"), "crypto": c("muted"), "document": c("fg"),
                      "compressed": c("pink"), "temp": c("red"), "compiled": c("blue"),
                      "build": c("muted"), "source": c("orange")},
    }
    out = "colourful: true\n"
    for section, entries in sections.items():
        out += f"{section}:\n" + "".join(f"  {k}: {v}\n" for k, v in entries.items())
    for key, color in [("punctuation", "overlay"), ("date", "cyan"), ("inode", "subtle"),
                       ("blocks", "subtle"), ("octal", "muted"), ("symlink_path", "cyan"),
                       ("control_char", "blue"), ("broken_symlink", "red"),
                       ("broken_path_overlay", "surface_hi")]:
        out += f"{key}: {c(color)}\n"
    # eza gives these folder names their own icon; use its plain folder icon (\ue5ff, same as yazi)
    special = [".config", ".git", ".github", ".npm", ".ssh", ".Trash", "build", "config", "Contacts",
               "cron.d", "cron.daily", "cron.hourly", "cron.monthly", "cron.weekly", "Desktop",
               "Documents", "Downloads", "etc", "Favorites", "hidden", "home", "include", "Mail",
               "Movies", "Music", "node_modules", "npm_cache", "pam.d", "Pictures", "src", "ssh",
               "sudoers.d", "Videos", "xbps.d", "xorg.conf.d"]
    out += "filenames:\n" + "".join(f'  "{n}": {{icon: {{glyph: "\ue5ff"}}}}\n' for n in special)
    return out + "header: {foreground: \"%s\", is_underline: true}\n" % p["fg"]


def yazi(p):
    def st(fg=None, bg=None, **flags):
        parts = [f'fg = "{p[fg]}"'] if fg else []
        parts += [f'bg = "{p[bg]}"'] if bg else []
        parts += [f"{k} = true" for k in flags]
        return "{ " + ", ".join(parts) + " }" if parts else "{}"

    sections = {
        "mgr": {
            "cwd": st("cyan"),
            "find_keyword": st("yellow", bold=1, italic=1),
            "find_position": st("pink", bold=1, italic=1),
            "marker_copied": st("green", "green"),
            "marker_cut": st("red", "red"),
            "marker_marked": st("cyan", "cyan"),
            "marker_selected": st("accent", "accent"),
            "count_copied": st("bg", "green"),
            "count_cut": st("bg", "red"),
            "count_selected": st("bg", "accent"),
            "border_style": st("surface_alt"),
        },
        "tabs": {"active": st("bg", "accent", bold=1), "inactive": st("accent", "surface")},
        "mode": {
            "normal_main": st("bg", "accent", bold=1), "normal_alt": st("accent", "surface"),
            "select_main": st("bg", "purple", bold=1), "select_alt": st("purple", "surface"),
            "unset_main": st("bg", "red", bold=1), "unset_alt": st("red", "surface"),
        },
        "indicator": {"parent": st("fg", "surface_alt"), "current": st("bg", "accent"),
                      "preview": st("fg", "surface")},
        "status": {
            "perm_sep": st("overlay"), "perm_type": st("blue"), "perm_read": st("yellow"),
            "perm_write": st("red"), "perm_exec": st("green"),
            "progress_label": st("fg", bold=1), "progress_normal": st("accent", "surface_alt"),
            "progress_error": st("red", "surface_alt"),
        },
        "which": {"mask": st(bg="bg_alt"), "cand": st("cyan"), "rest": st("muted"),
                  "desc": st("pink"), "separator_style": st("surface_hi")},
        "confirm": {"border": st("accent"), "title": st("accent"), "btn_yes": st("bg", "accent")},
        "spot": {"border": st("accent"), "title": st("accent"), "tbl_col": st("accent"),
                 "tbl_cell": st("bg", "yellow")},
        "notify": {"title_info": st("green"), "title_warn": st("yellow"), "title_error": st("red")},
        "pick": {"border": st("accent"), "active": st("purple", bold=1)},
        "input": {"border": st("accent"), "selected": st("bg", "accent")},
        "cmp": {"border": st("accent"), "active": st("bg", "accent")},
        "tasks": {"border": st("accent"), "hovered": st("purple", bold=1)},
        "help": {"border": st("accent"), "chord": st("cyan"), "hovered": st("bg", "accent", bold=1)},
    }
    out = "# generated by ~/.local/bin/theme\n"
    for name, entries in sections.items():
        out += f"\n[{name}]\n" + "".join(f"{k} = {v}\n" for k, v in entries.items())
    rules = [
        ('mime = "**/image/*"', st("yellow")),
        ('mime = "**/{audio,video}/*"', st("pink")),
        ('mime = "**/application/{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio,arj,xar,ms-cab*}"', st("red")),
        ('mime = "**/application/{pdf,doc,rtf}"', st("cyan")),
        ('mime = "vfs/{absent,stale}"', st("overlay")),
        ('url = "*", is = "orphan"', st(bg="red")),
        ('url = "*", is = "exec"', st("green")),
        ('url = "*", is = "dummy"', st(bg="red")),
        ('url = "*/", is = "dummy"', st(bg="red")),
        ('url = "*/"', st("accent", bold=1)),
    ]
    # yazi's folder icons have fixed colors and per-name glyphs (Music, Desktop, ...);
    # drop the per-name ones and give every folder the plain icon in the theme color
    out += "\n[icon]\ndirs = []\n"
    out += 'prepend_conds = [\n    { if = "dir", text = "\ue5ff", fg = "%s" },\n]\n' % p["accent"]
    out += "\n[filetype]\nrules = [\n" + "".join(
        f"    {{ {match}, {style[2:-2]} }},\n" for match, style in rules) + "]\n"
    return out


RENDERERS = {
    "colors.json": lambda p: json.dumps(p, indent=4) + "\n",
    # rofi doesn't allow _ in names: bg_alt is @bg-alt there
    "colors.rasi": lambda p: "* {\n" + "".join(f"    {k.replace('_', '-')}: {v};\n" for k, v in p.items()) + "}\n",
    "colors.css": lambda p: "".join(f"@define-color {k} {v};\n" for k, v in p.items()),
    "kitty.conf": kitty,
    "hypr.lua": lambda p: "return {\n" + "".join(f'    {k} = "{v[1:]}",\n' for k, v in p.items()) + "}\n",
    "hyprlock.conf": lambda p: "".join(f"${k} = rgb({v[1:]})\n${k}Alpha = {v[1:]}\n" for k, v in p.items()),
    "dunst.conf": dunst,
    "eza/theme.yml": eza,
    "yazi.toml": yazi,
}


def flavors():
    return sorted(f.stem for f in PALETTES.glob("*.json"))


def themes():
    """Themes that have both a dark and a light palette."""
    return sorted({f.rsplit("-", 1)[0] for f in flavors()
                   if all(f"{f.rsplit('-', 1)[0]}-{m}" in flavors() for m in MODES)})


def split(flavor):
    theme, _, mode = flavor.rpartition("-")
    return theme, mode


def current():
    try:
        flavor = FLAVOR_FILE.read_text().strip()
    except FileNotFoundError:
        return DEFAULT
    return flavor if flavor in flavors() else DEFAULT


def write(flavor):
    p = load(flavor)
    for name, render in RENDERERS.items():
        (CURRENT / name).parent.mkdir(parents=True, exist_ok=True)
        # overwrite in place (same inode) so file watchers see a change
        with open(CURRENT / name, "w") as f:
            f.write(render(p))
    FLAVOR_FILE.write_text(flavor + "\n")
    return p


def run(*cmd):
    if shutil.which(cmd[0]):
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def set_vscode_theme(text, flavor):
    # other themes need their own VS Code extension, so use Catppuccin in the same mode
    name = VSCODE_THEMES.get(flavor) or VSCODE_THEMES["catppuccin-" + split(flavor)[1]]
    return VSCODE_KEY.sub(lambda m: f'{m.group(1)}"{name}"', text) if name else text


def vscode(flavor):
    try:
        text = VSCODE_SETTINGS.read_text()
    except FileNotFoundError:
        return
    new = set_vscode_theme(text, flavor)
    if new != text:
        # write through the symlink, in place; VS Code picks it up live
        with open(VSCODE_SETTINGS, "w") as f:
            f.write(new)


def link(path, target):
    if path.is_symlink() and path.readlink() == target:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    path.unlink(missing_ok=True)
    path.symlink_to(target)


def hls(color):
    return colorsys.rgb_to_hls(*(int(color[i:i + 2], 16) / 255 for i in (1, 3, 5)))


def recolor(color, accent):
    """Give a shade of Adwaita's folder blue the accent's hue and saturation; lightness
    stays Adwaita's so the folder keeps its contrast on light and dark backgrounds."""
    h, l, s = hls(color)
    _, _, s0 = hls(ADWAITA_FOLDER)
    th, _, ts = hls(accent)
    s = min(1, max(0, s * ts / s0 if s0 else ts))
    return "#%02x%02x%02x" % tuple(round(c * 255) for c in colorsys.hls_to_rgb(th, l, s))


def clean_generated(directory, keep):
    """Remove Theme-* dirs this script made for palettes that no longer exist."""
    for old in directory.glob("Theme-*"):
        index = old / "index.theme"
        if old.name not in keep and index.is_file() and "generated by ~/.local/bin/theme" in index.read_text():
            shutil.rmtree(old)


def icons(flavor, p):
    """Adwaita's folder icons recolored to the accent, in an icon theme inheriting Adwaita."""
    if not ADWAITA_PLACES.is_dir():
        return None
    name = gtk_theme_name(flavor)
    clean_generated(DATA / "icons", {gtk_theme_name(f) for f in flavors()})
    places = DATA / "icons" / name / "scalable/places"
    places.mkdir(parents=True, exist_ok=True)
    # every folder-like icon (folder*, user-home, user-desktop, ...) uses the same blue
    for svg in ADWAITA_PLACES.glob("*.svg"):
        text = svg.read_text()
        if ADWAITA_FOLDER in text.lower():
            (places / svg.name).write_text(HEX.sub(lambda m: recolor(m.group(0), p["accent"]), text))
    (places.parent.parent / "index.theme").write_text(
        f"[Icon Theme]\nName={name}\nComment=generated by ~/.local/bin/theme\n"
        "Inherits=Adwaita,AdwaitaLegacy,hicolor\nDirectories=scalable/places\n\n"
        "[scalable/places]\nContext=Places\nSize=128\nMinSize=8\nMaxSize=512\nType=Scalable\n")
    return name


def wallpaper(flavor, transition=True):
    theme, _ = split(flavor)
    for stem in (flavor, theme, "background"):
        found = sorted(BACKGROUNDS.glob(f"{stem}.*"))
        if found:
            # a fixed path to the current wallpaper, for hyprlock
            link(CURRENT / "wallpaper", found[0])
            cmd = ["awww", "img", str(found[0])]
            if transition:
                cmd += ["--transition-type", "grow", "--transition-pos", "top-right",
                        "--transition-duration", "1.2", "--transition-fps", "120"]
            run(*cmd)
            return


def gtk_theme_name(flavor):
    return f"Theme-{flavor}"


def gtk(flavor, p):
    """adw-gtk3 takes libadwaita's named colors, so a theme is an import plus overrides.
    Each flavor gets its own theme name: GTK only reloads when the name changes."""
    dark = is_dark(p)
    base = ADW_GTK3 / ("adw-gtk3-dark" if dark else "adw-gtk3") / "gtk-3.0/gtk.css"
    if not base.exists():
        return False
    shade = "rgba(0, 0, 0, 0.36)" if dark else "rgba(0, 0, 0, 0.07)"
    colors = {
        "accent_color": p["accent"], "accent_bg_color": p["accent"], "accent_fg_color": p["bg"],
        "destructive_color": p["red"], "destructive_bg_color": p["red"], "destructive_fg_color": p["bg"],
        "success_color": p["green"], "success_bg_color": p["green"], "success_fg_color": p["bg"],
        "warning_color": p["yellow"], "warning_bg_color": p["yellow"], "warning_fg_color": p["bg"],
        "error_color": p["red"], "error_bg_color": p["red"], "error_fg_color": p["bg"],
        "window_bg_color": p["bg"], "window_fg_color": p["fg"],
        "view_bg_color": p["bg"], "view_fg_color": p["fg"],
        "headerbar_bg_color": p["bg_alt"], "headerbar_fg_color": p["fg"],
        "headerbar_border_color": p["surface"], "headerbar_backdrop_color": p["bg"],
        "headerbar_shade_color": shade,
        "sidebar_bg_color": p["bg_alt"], "sidebar_fg_color": p["fg"],
        "sidebar_backdrop_color": p["bg_alt"], "sidebar_shade_color": shade,
        "card_bg_color": p["surface"], "card_fg_color": p["fg"], "card_shade_color": shade,
        "dialog_bg_color": p["bg"], "dialog_fg_color": p["fg"],
        "popover_bg_color": p["bg_alt"], "popover_fg_color": p["fg"],
        "shade_color": shade, "scrollbar_outline_color": p["bg_deep"],
    }
    clean_generated(DATA / "themes", {gtk_theme_name(f) for f in flavors()})
    theme = DATA / "themes" / gtk_theme_name(flavor)
    (theme / "gtk-3.0").mkdir(parents=True, exist_ok=True)
    (theme / "index.theme").write_text(
        f"[Desktop Entry]\nType=X-GNOME-Metatheme\nName={gtk_theme_name(flavor)}\n"
        "Comment=generated by ~/.local/bin/theme\n")
    (theme / "gtk-3.0/gtk.css").write_text(
        f'/* generated by ~/.local/bin/theme */\n@import url("file://{base}");\n\n'
        + "".join(f"@define-color {k} {v};\n" for k, v in colors.items()))
    return True


def export(flavor, p):
    """Write the files that live outside $XDG_STATE_HOME/theme."""
    vscode(flavor)
    link(DUNST_DROPIN, CURRENT / "dunst.conf")
    link(YAZI_THEME, CURRENT / "yazi.toml")


def apply(flavor, p):
    export(flavor, p)
    run("dunstctl", "reload")
    dark = is_dark(p)
    run("gsettings", "set", "org.gnome.desktop.interface", "color-scheme", "prefer-dark" if dark else "prefer-light")
    fallback = "Adwaita-dark" if dark else "Adwaita"
    run("gsettings", "set", "org.gnome.desktop.interface", "icon-theme", icons(flavor, p) or "Adwaita")
    wallpaper(flavor)
    run("gsettings", "set", "org.gnome.desktop.interface", "gtk-theme",
        gtk_theme_name(flavor) if gtk(flavor, p) else fallback)
    run("pkill", "-USR1", "-x", "kitty")
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        run("hyprctl", "reload")


def swatch(theme):
    """Square SVG for the rofi menu: the dark palette on the left, the light one on the
    right, each with its accent2, accent and green as dots."""
    halves = ""
    for i, mode in enumerate(MODES):
        p = load(f"{theme}-{mode}")
        dots = "".join(f'<circle cx="{i * 32 + 16}" cy="{14 + j * 18}" r="6" fill="{p[c]}"/>'
                       for j, c in enumerate(["accent2", "accent", "green"]))
        halves += f'<rect x="{i * 32}" width="32" height="64" fill="{p["bg"]}"/>{dots}'
    SWATCHES.mkdir(parents=True, exist_ok=True)
    path = SWATCHES / f"{theme}.svg"
    path.write_text('<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64">'
                    '<clipPath id="r"><rect width="64" height="64" rx="12"/></clipPath>'
                    f'<g clip-path="url(#r)">{halves}</g></svg>')
    return path


def menu():
    """Pick a theme with rofi; returns it or None."""
    names = themes()
    cur = split(current())[0]
    rows = "".join(f"{t}\0icon\x1f{swatch(t)}\n" for t in names)
    result = subprocess.run(
        ["rofi", "-dmenu", "-i", "-p", "theme", "-show-icons", "-no-custom",
         "-selected-row", str(names.index(cur) if cur in names else 0),
         "-theme-str", "element-icon { size: 40px; }"],
        input=rows, capture_output=True, text=True)
    choice = result.stdout.strip()
    return choice if choice in names else None


def main(args):
    cmd = args[0] if args else "current"
    theme, mode = split(current())
    if cmd == "current":
        print(current())
    elif cmd == "list":
        print("\n".join(themes()))
    elif cmd == "init":
        export(current(), write(current()))
    elif cmd in ("toggle", "menu") or cmd in themes() or cmd in flavors():
        if cmd == "toggle":
            flavor = f"{theme}-{MODES[1 - MODES.index(mode)]}"
        elif cmd == "menu":
            picked = menu()
            if not picked:
                return 0
            flavor = f"{picked}-{mode}"
        elif cmd in themes():
            flavor = f"{cmd}-{mode}"
        else:
            flavor = cmd
        apply(flavor, write(flavor))
    elif cmd == "wallpaper":
        wallpaper(current(), transition=False)
    elif cmd == "vscode-clean":
        # git clean filter: stdin -> stdout with the default theme
        sys.stdout.write(set_vscode_theme(sys.stdin.read(), DEFAULT))
    else:
        print(__doc__.strip().splitlines()[-1], file=sys.stderr)
        print("themes: " + ", ".join(themes()), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
