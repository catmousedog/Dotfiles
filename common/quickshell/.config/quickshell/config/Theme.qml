// Theme.qml

pragma Singleton

import Quickshell
import Quickshell.Io
import QtQuick
import QtCore

Singleton {
    id: root

    // the accent2 -> accent gradient of every border: `gradient: Theme.accentGradient`
    readonly property Gradient accentGradient: Gradient {
        orientation: Gradient.Horizontal
        GradientStop {
            position: 0.0
            color: root.accent2
        }
        GradientStop {
            position: 1.0
            color: root.accent
        }
    }

    function getColor(name: string): string {
        return json[name] ?? "";
    }

    // roles from the palette, see ~/.local/bin/theme
    property string bg: json.bg
    property string bg_alt: json.bg_alt
    property string bg_deep: json.bg_deep
    property string surface: json.surface
    property string surface_alt: json.surface_alt
    property string surface_hi: json.surface_hi
    property string overlay: json.overlay
    property string muted: json.muted
    property string subtle: json.subtle
    property string fg: json.fg
    property string accent: json.accent
    property string accent2: json.accent2
    property string red: json.red
    property string orange: json.orange
    property string yellow: json.yellow
    property string green: json.green
    property string cyan: json.cyan
    property string blue: json.blue
    property string purple: json.purple
    property string pink: json.pink

    FileView {
        // generated by ~/.local/bin/theme
        path: (Quickshell.env("XDG_STATE_HOME") || Quickshell.env("HOME") + "/.local/state") + "/theme/current/colors.json"

        watchChanges: true
        onFileChanged: reload()

        JsonAdapter {
            id: json
            property string bg
            property string bg_alt
            property string bg_deep
            property string surface
            property string surface_alt
            property string surface_hi
            property string overlay
            property string muted
            property string subtle
            property string fg
            property string accent
            property string accent2
            property string red
            property string orange
            property string yellow
            property string green
            property string cyan
            property string blue
            property string purple
            property string pink
        }
    }
}
