# Which host this checkout is (see Makefile)
/.host

# Secrets: never commit these. Put them next to the config that needs them,
# e.g. common/fish/.config/fish/conf.d/secrets.fish or hosts/<host>/.../secrets.*
secrets.*
*.secret

# Wallpapers (large binaries)
common/backgrounds/.config/backgrounds/*

# Theme preview scratch output
__pycache__/
