@import "/home/arno/.config/themes/theme.rasi"

* {
    background-color:  transparent;
    text-color:         @text;
}

window {
    transparency:      "real";
    background-color:  @base;
    border:             2px;
    border-color:       @mauve;
    border-radius:      14px;
    width:              600px;
    location:           center;
    padding:            14px;
}

mainbox {
    children:  [ inputbar, listview ];
    spacing:    10px;
}

inputbar {
    background-color:  @mantle;
    border-radius:      10px;
    padding:            10px 14px;
    children:          [ prompt, entry ];
    spacing:            8px;
}

prompt {
    text-color:  @mauve;
    font:        "JetBrainsMono Nerd Font Bold 11";
}

entry {
    placeholder:        "Search...";
    placeholder-color:  @overlay0;
    text-color:         @text;
}

listview {
    lines:          8;
    spacing:        4px;
    scrollbar:      false;
    fixed-height:   false;
}

element {
    padding:        8px 10px;
    border-radius:  8px;
}

element normal.normal {
    text-color:  @text;
}

element selected.normal {
    background-color:  @surface0;
    text-color:         @mauve;
}

element-icon {
    size:            22px;
    vertical-align:  0.5;
}

element-text {
    vertical-align:  0.5;
}
