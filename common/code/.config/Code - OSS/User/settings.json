{
	// ========== Fonts ========== //
	"editor.fontSize": 16,
	"terminal.integrated.fontSize": 16,
	"debug.console.fontSize": 16,
	"keyboard.dispatch": "keyCode",
	// ========== Editor ========== //
	"editor.stickyScroll.maxLineCount": 3,
	"editor.formatOnSave": true,
	"editor.fontFamily": "'Droid Sans Mono', 'monospace', monospace, 'Symbols Nerd Font'",
	"editor.inlayHints.enabled": "off", // inline variable names 
	"editor.cursorSurroundingLines": 20,
	"editor.insertSpaces": false,
	"editor.detectIndentation": false,
	"editor.tabSize": 4,
	"editor.smoothScrolling": true,
	"editor.cursorSmoothCaretAnimation": "on",
	"editor.cursorBlinking": "smooth",
	"editor.unicodeHighlight.allowedCharacters": {
		"’": true
	},
	"diffEditor.renderSideBySide": true,
	// ========== Terminal ========== //
	"terminal.integrated.commandsToSkipShell": [
		"workbench.debug.action.focusRepl", // allows to focus debug console while terminal is focused
		"workbench.debug.action.focusWatchView"
	],
	"terminal.integrated.smoothScrolling": true,
	"terminal.integrated.initialHint": false,
	"debug.console.wordWrap": false,
	// ========== File Explorer ========== //
	"explorer.autoReveal": false,
	"explorer.confirmDelete": false,
	"explorer.confirmDragAndDrop": false,
	"files.exclude": {
		"**/__pycache__": true,
		"**/.git": true,
		"**/.claude": true
	},
	// ========== Window ========== //
	"window.commandCenter": false,
	"window.customMenuBarAltFocus": false,
	"window.openFilesInNewWindow": "off",
	"window.openFoldersInNewWindow": "off",
	"chat.titleBar.signIn.enabled": false,
	"chat.titleBar.openInAgentsWindow.enabled": false,
	// ========== Workbench ========== //
	"workbench.panel.opensMaximized": "never",
	"workbench.secondarySideBar.defaultVisibility": "hidden",
	// switched by ~/.local/bin/theme (always committed as Mocha, see .gitattributes)
	"workbench.colorTheme": "Desktop Dark",
	"workbench.startupEditor": "none",
	"workbench.tree.indent": 16,
	"workbench.list.smoothScrolling": true,
	// ========== Debugging ========== //
	"debug.inlineValues": "on",
	"debug.onTaskErrors": "abort",
	"debug.openDebug": "neverOpen",
	"lldb.showDisassembly": "never",
	// ========== Tasks ========== //
	"task.autoDetect": "off",
	// ========== Git ========== //
	"git.blame.editorDecoration.enabled": false,
	"git.blame.statusBarItem.enabled": true,
	"git.openRepositoryInParentFolders": "never",
	// ========== Language-Specific ========== //
	// Python
	"python.terminal.executeInFileDir": true,
	"python.defaultInterpreterPath": "~/.venvs/script/bin/python",
	// C/C++
	"clangd.path": "/usr/bin/clangd",
	"[cpp]": {
		"editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
	},
	// LaTeX
	"latex-workshop.latex.outDir": "pdf",
	"latex-workshop.latex.auxDir": "build",
	"latex-workshop.latex.bibDirs": "build",
	"latex-workshop.latex.texDirs": "build",
	"latex-workshop.latex.autoBuild.run": "onSave",
	"latex-workshop.view.pdf.color.dark.backgroundColor": "#1e1e2e", // base
	"latex-workshop.view.pdf.color.dark.pageBorderColor": "#45475a", // surface1
	"latex-workshop.formatting.latex": "tex-fmt",
	// "latex-workshop.view.pdf.color.dark.pageColorsForeground": "#cdd6f4", // text
	"latex-workshop.view.pdf.color.dark.pageColorsBackground": "#181825", // mantle
	// ========== SuperMaven ========== // 
	"supermaven.otherWarning": false,
	// ========== Comment Driver ========== //
	"comment-driver.length": 60,
	"comment-driver.lineFiller": "=",
	"comment-driver.subheaderFiller": "=",
	"comment-driver.subheaderTransform": "uppercase",
	"comment-driver.mainHeaderFiller": "=",
	// ========== Claude ========== //
	"claudeCode.hideOnboarding": true,
	// ========== Security ========== //
	"security.workspace.trust.untrustedFiles": "open",
	// ========== Newly Added ========== // 
}