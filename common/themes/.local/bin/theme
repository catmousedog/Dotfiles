#!/usr/bin/env python3
"""Generate and switch the desktop color theme.

The single source of truth is ~/.config/themes/palettes/<flavor>.json. This
script renders it into every format the desktop needs and writes the result
to $XDG_STATE_HOME/theme/current/, which the configs read from:

    colors.json    quickshell (watched, reloads by itself)
    colors.rasi    rofi
    colors.css     GTK-style @define-color
    kitty.conf     kitty (reloaded with SIGUSR1)
    hypr.lua       hyprland (reloaded with hyprctl reload)
    hyprlock.conf  hyprlock ($name / $nameAlpha variables)
    dunst.conf     dunst, linked as ~/.config/dunst/dunstrc.d/90-theme.conf
    eza/theme.yml  eza (EZA_CONFIG_DIR points here, see config.fish)
    yazi.toml      yazi, linked as ~/.config/yazi/theme.toml (read on start)

Some programs can't read from another location, so their files are written
directly (they aren't in the repo, edit this script instead):

    ~/.local/share/icons/Theme/            Adwaita with mauve folders (Thunar, dialogs)
    ~/.local/share/themes/Theme-<flavor>/  GTK 3 theme: adw-gtk3 recolored. GTK apps
                                           (Thunar, file dialogs) restyle live when
                                           the gtk-theme setting switches to it

VS Code gets its color theme written straight into settings.json; its own
"follow the system theme" option doesn't work reliably here. A git clean
filter (`theme vscode-clean`, set up by the Makefile) keeps that line at the
default in the repo, so toggling doesn't leave settings.json modified.

Usage: theme [init | toggle | current | list | <flavor> | vscode-clean]
"""

import colorsys
import json
import re
import os
import shutil
import subprocess
import sys
from pathlib import Path

# resolved via the script itself so it also works straight from the repo, before stowing
PALETTES = Path(__file__).resolve().parents[2] / ".config/themes/palettes"
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "theme"
CURRENT = STATE / "current"
FLAVOR_FILE = STATE / "flavor"
DEFAULT = "mocha"
TOGGLE = {"mocha": "latte", "latte": "mocha"}

VSCODE_SETTINGS = CONFIG / "Code - OSS/User/settings.json"
DUNST_DROPIN = CONFIG / "dunst/dunstrc.d/90-theme.conf"
YAZI_THEME = CONFIG / "yazi/theme.toml"
DATA = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
ADW_GTK3 = Path("/usr/share/themes")  # adw-gtk3 and adw-gtk3-dark, from adw-gtk-theme
ADWAITA_PLACES = Path("/usr/share/icons/Adwaita/scalable/places")
ICON_THEME = "Theme"
HEX = re.compile(r"#[0-9a-fA-F]{6}\b")
VSCODE_THEMES = {"mocha": "Catppuccin Mocha", "latte": "Catppuccin Latte"}
VSCODE_KEY = re.compile(r'("workbench\.colorTheme"\s*:\s*)"[^"]*"')


def load(flavor):
    return json.loads((PALETTES / f"{flavor}.json").read_text())


def is_dark(p):
    r, g, b = (int(p["base"][i:i + 2], 16) for i in (1, 3, 5))
    return (0.299 * r + 0.587 * g + 0.114 * b) < 128


def kitty(p):
    dark = is_dark(p)
    lines = {
        "foreground": p["text"],
        "background": p["base"],
        "selection_foreground": p["base"],
        "selection_background": p["rosewater"],
        "cursor": p["rosewater"],
        "cursor_text_color": p["base"],
        "url_color": p["rosewater"],
        "active_border_color": p["lavender"],
        "inactive_border_color": p["overlay0"],
        "bell_border_color": p["yellow"],
        "wayland_titlebar_color": "system",
        "active_tab_foreground": p["crust"] if dark else p["base"],
        "active_tab_background": p["mauve"],
        "inactive_tab_foreground": p["text"],
        "inactive_tab_background": p["mantle"] if dark else p["overlay0"],
        "tab_bar_background": p["crust"] if dark else p["surface1"],
        "mark1_foreground": p["base"],
        "mark1_background": p["lavender"],
        "mark2_foreground": p["base"],
        "mark2_background": p["mauve"],
        "mark3_foreground": p["base"],
        "mark3_background": p["sapphire"],
        # black / white slots swap roles between dark and light flavors
        "color0": p["surface1"] if dark else p["subtext1"],
        "color8": p["surface2"] if dark else p["subtext0"],
        "color7": p["subtext1"] if dark else p["surface2"],
        "color15": p["subtext0"] if dark else p["surface1"],
    }
    for normal, bright, name in [(1, 9, "red"), (2, 10, "green"), (3, 11, "yellow"),
                                 (4, 12, "blue"), (5, 13, "pink"), (6, 14, "teal")]:
        lines[f"color{normal}"] = lines[f"color{bright}"] = p[name]
    return "".join(f"{k} {v}\n" for k, v in lines.items())


def dunst(p):
    def urgency(name, fg, frame, highlight):
        return (f"[urgency_{name}]\n    background = \"{p['base']}\"\n    foreground = \"{fg}\"\n"
                f"    frame_color = \"{frame}\"\n    highlight = \"{highlight}\"\n")
    # the progress bar uses the same red -> blue gradient as the bar's borders
    return (urgency("low", p["subtext0"], p["overlay0"], p["overlay1"])
            + urgency("normal", p["text"], p["blue"], f"{p['red']}, {p['blue']}")
            + urgency("critical", p["text"], p["red"], p["red"]))


def eza(p):
    def c(color, bold=False):
        return "{foreground: \"%s\"%s}" % (p[color], ", is_bold: true" if bold else "")
    sections = {
        "filekinds": {"normal": c("text"), "directory": c("mauve", True), "symlink": c("teal"),
                      "pipe": c("overlay1"), "block_device": c("peach"), "char_device": c("peach"),
                      "socket": c("overlay1"), "special": c("pink"), "executable": c("green", True),
                      "mount_point": c("sapphire", True)},
        "perms": {"user_read": c("yellow"), "user_write": c("red"), "user_execute_file": c("green"),
                  "user_execute_other": c("green"), "group_read": c("yellow"), "group_write": c("red"),
                  "group_execute": c("green"), "other_read": c("yellow"), "other_write": c("red"),
                  "other_execute": c("green"), "special_user_file": c("mauve"),
                  "special_other": c("overlay1"), "attribute": c("overlay1")},
        "size": {"major": c("subtext0"), "minor": c("lavender"), "number_byte": c("text"),
                 "number_kilo": c("text"), "number_mega": c("blue"), "number_giga": c("mauve"),
                 "number_huge": c("red"), "unit_byte": c("overlay1"), "unit_kilo": c("overlay1"),
                 "unit_mega": c("overlay1"), "unit_giga": c("overlay1"), "unit_huge": c("overlay1")},
        "users": {"user_you": c("text"), "user_root": c("red"), "user_other": c("mauve"),
                  "group_yours": c("subtext1"), "group_other": c("overlay1"), "group_root": c("red")},
        "links": {"normal": c("sky"), "multi_link_file": c("sky", True)},
        "git": {"new": c("green"), "modified": c("yellow"), "deleted": c("red"), "renamed": c("teal"),
                "typechange": c("pink"), "ignored": c("overlay0"), "conflicted": c("maroon")},
        "git_repo": {"branch_main": c("text"), "branch_other": c("mauve"), "git_clean": c("green"),
                     "git_dirty": c("red")},
        "file_type": {"image": c("yellow"), "video": c("red"), "music": c("green"),
                      "lossless": c("teal"), "crypto": c("overlay2"), "document": c("text"),
                      "compressed": c("pink"), "temp": c("maroon"), "compiled": c("lavender"),
                      "build": c("overlay2"), "source": c("peach")},
    }
    out = "colourful: true\n"
    for section, entries in sections.items():
        out += f"{section}:\n" + "".join(f"  {k}: {v}\n" for k, v in entries.items())
    for key, color in [("punctuation", "overlay0"), ("date", "teal"), ("inode", "subtext0"),
                       ("blocks", "subtext0"), ("octal", "overlay2"), ("symlink_path", "sky"),
                       ("control_char", "sapphire"), ("broken_symlink", "red"),
                       ("broken_path_overlay", "surface2")]:
        out += f"{key}: {c(color)}\n"
    return out + "header: {foreground: \"%s\", is_underline: true}\n" % p["text"]


def yazi(p):
    def st(fg=None, bg=None, **flags):
        parts = [f'fg = "{p[fg]}"'] if fg else []
        parts += [f'bg = "{p[bg]}"'] if bg else []
        parts += [f"{k} = true" for k in flags]
        return "{ " + ", ".join(parts) + " }" if parts else "{}"

    sections = {
        "mgr": {
            "cwd": st("teal"),
            "find_keyword": st("yellow", bold=1, italic=1),
            "find_position": st("pink", bold=1, italic=1),
            "marker_copied": st("green", "green"),
            "marker_cut": st("red", "red"),
            "marker_marked": st("teal", "teal"),
            "marker_selected": st("blue", "blue"),
            "count_copied": st("base", "green"),
            "count_cut": st("base", "red"),
            "count_selected": st("base", "blue"),
            "border_style": st("surface1"),
        },
        "tabs": {"active": st("base", "blue", bold=1), "inactive": st("blue", "surface0")},
        "mode": {
            "normal_main": st("base", "blue", bold=1), "normal_alt": st("blue", "surface0"),
            "select_main": st("base", "mauve", bold=1), "select_alt": st("mauve", "surface0"),
            "unset_main": st("base", "red", bold=1), "unset_alt": st("red", "surface0"),
        },
        "indicator": {"parent": st("text", "surface1"), "current": st("base", "blue"),
                      "preview": st("text", "surface0")},
        "status": {
            "perm_sep": st("overlay0"), "perm_type": st("blue"), "perm_read": st("yellow"),
            "perm_write": st("red"), "perm_exec": st("green"),
            "progress_label": st("text", bold=1), "progress_normal": st("blue", "surface1"),
            "progress_error": st("red", "surface1"),
        },
        "which": {"mask": st(bg="mantle"), "cand": st("teal"), "rest": st("overlay2"),
                  "desc": st("pink"), "separator_style": st("surface2")},
        "confirm": {"border": st("blue"), "title": st("blue"), "btn_yes": st("base", "blue")},
        "spot": {"border": st("blue"), "title": st("blue"), "tbl_col": st("blue"),
                 "tbl_cell": st("base", "yellow")},
        "notify": {"title_info": st("green"), "title_warn": st("yellow"), "title_error": st("red")},
        "pick": {"border": st("blue"), "active": st("mauve", bold=1)},
        "input": {"border": st("blue"), "selected": st("base", "blue")},
        "cmp": {"border": st("blue"), "active": st("base", "blue")},
        "tasks": {"border": st("blue"), "hovered": st("mauve", bold=1)},
        "help": {"border": st("blue"), "chord": st("teal"), "hovered": st("base", "blue", bold=1)},
    }
    out = "# generated by ~/.local/bin/theme\n"
    for name, entries in sections.items():
        out += f"\n[{name}]\n" + "".join(f"{k} = {v}\n" for k, v in entries.items())
    rules = [
        ('mime = "**/image/*"', st("yellow")),
        ('mime = "**/{audio,video}/*"', st("pink")),
        ('mime = "**/application/{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio,arj,xar,ms-cab*}"', st("red")),
        ('mime = "**/application/{pdf,doc,rtf}"', st("teal")),
        ('mime = "vfs/{absent,stale}"', st("overlay0")),
        ('url = "*", is = "orphan"', st(bg="red")),
        ('url = "*", is = "exec"', st("green")),
        ('url = "*", is = "dummy"', st(bg="red")),
        ('url = "*/", is = "dummy"', st(bg="red")),
        ('url = "*/"', st("mauve", bold=1)),
    ]
    out += "\n[filetype]\nrules = [\n" + "".join(
        f"    {{ {match}, {style[2:-2]} }},\n" for match, style in rules) + "]\n"
    return out


RENDERERS = {
    "colors.json": lambda p: json.dumps(p, indent=4) + "\n",
    "colors.rasi": lambda p: "* {\n" + "".join(f"    {k}: {v};\n" for k, v in p.items()) + "}\n",
    "colors.css": lambda p: "".join(f"@define-color {k} {v};\n" for k, v in p.items()),
    "kitty.conf": kitty,
    "hypr.lua": lambda p: "return {\n" + "".join(f'    {k} = "{v[1:]}",\n' for k, v in p.items()) + "}\n",
    "hyprlock.conf": lambda p: "".join(f"${k} = rgb({v[1:]})\n${k}Alpha = {v[1:]}\n" for k, v in p.items()),
    "dunst.conf": dunst,
    "eza/theme.yml": eza,
    "yazi.toml": yazi,
}


def current():
    try:
        return FLAVOR_FILE.read_text().strip()
    except FileNotFoundError:
        return DEFAULT


def write(flavor):
    p = load(flavor)
    for name, render in RENDERERS.items():
        (CURRENT / name).parent.mkdir(parents=True, exist_ok=True)
        # overwrite in place (same inode) so file watchers see a change
        with open(CURRENT / name, "w") as f:
            f.write(render(p))
    FLAVOR_FILE.write_text(flavor + "\n")
    return p


def run(*cmd):
    if shutil.which(cmd[0]):
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def set_vscode_theme(text, flavor):
    name = VSCODE_THEMES.get(flavor)
    return VSCODE_KEY.sub(lambda m: f'{m.group(1)}"{name}"', text) if name else text


def vscode(flavor):
    try:
        text = VSCODE_SETTINGS.read_text()
    except FileNotFoundError:
        return
    new = set_vscode_theme(text, flavor)
    if new != text:
        # write through the symlink, in place; VS Code picks it up live
        with open(VSCODE_SETTINGS, "w") as f:
            f.write(new)


def link(path, target):
    if path.is_symlink() and path.readlink() == target:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    path.unlink(missing_ok=True)
    path.symlink_to(target)


def recolor(color, hue):
    """Same lightness and saturation, with the hue of the palette's accent."""
    r, g, b = (int(color[i:i + 2], 16) / 255 for i in (1, 3, 5))
    _, l, s = colorsys.rgb_to_hls(r, g, b)
    r, g, b = colorsys.hls_to_rgb(hue, l, s)
    return "#%02x%02x%02x" % (round(r * 255), round(g * 255), round(b * 255))


def icons(p):
    """Adwaita's folder icons are blue; copy them with the accent's (mauve) hue into
    an icon theme that inherits everything else from Adwaita."""
    if not ADWAITA_PLACES.is_dir():
        return False
    r, g, b = (int(p["mauve"][i:i + 2], 16) / 255 for i in (1, 3, 5))
    hue = colorsys.rgb_to_hls(r, g, b)[0]
    theme = DATA / "icons" / ICON_THEME
    places = theme / "scalable/places"
    places.mkdir(parents=True, exist_ok=True)
    for svg in ADWAITA_PLACES.glob("folder*.svg"):
        text = HEX.sub(lambda m: recolor(m.group(0), hue), svg.read_text())
        (places / svg.name).write_text(text)
    (theme / "index.theme").write_text(
        "[Icon Theme]\nName=Theme\nComment=generated by ~/.local/bin/theme\n"
        "Inherits=Adwaita,AdwaitaLegacy,hicolor\nDirectories=scalable/places\n\n"
        "[scalable/places]\nContext=Places\nSize=128\nMinSize=8\nMaxSize=512\nType=Scalable\n")
    return True


def gtk_theme_name(flavor):
    return f"Theme-{flavor}"


def gtk(flavor, p):
    """adw-gtk3 takes libadwaita's named colors, so a theme is an import plus overrides.
    Each flavor gets its own theme name: GTK only reloads when the name changes."""
    dark = is_dark(p)
    base = ADW_GTK3 / ("adw-gtk3-dark" if dark else "adw-gtk3") / "gtk-3.0/gtk.css"
    if not base.exists():
        return False
    shade = "rgba(0, 0, 0, 0.36)" if dark else "rgba(0, 0, 0, 0.07)"
    colors = {
        "accent_color": p["blue"], "accent_bg_color": p["blue"], "accent_fg_color": p["base"],
        "destructive_color": p["red"], "destructive_bg_color": p["red"], "destructive_fg_color": p["base"],
        "success_color": p["green"], "success_bg_color": p["green"], "success_fg_color": p["base"],
        "warning_color": p["yellow"], "warning_bg_color": p["yellow"], "warning_fg_color": p["base"],
        "error_color": p["red"], "error_bg_color": p["red"], "error_fg_color": p["base"],
        "window_bg_color": p["base"], "window_fg_color": p["text"],
        "view_bg_color": p["base"], "view_fg_color": p["text"],
        "headerbar_bg_color": p["mantle"], "headerbar_fg_color": p["text"],
        "headerbar_border_color": p["surface0"], "headerbar_backdrop_color": p["base"],
        "headerbar_shade_color": shade,
        "sidebar_bg_color": p["mantle"], "sidebar_fg_color": p["text"],
        "sidebar_backdrop_color": p["mantle"], "sidebar_shade_color": shade,
        "card_bg_color": p["surface0"], "card_fg_color": p["text"], "card_shade_color": shade,
        "dialog_bg_color": p["base"], "dialog_fg_color": p["text"],
        "popover_bg_color": p["mantle"], "popover_fg_color": p["text"],
        "shade_color": shade, "scrollbar_outline_color": p["crust"],
    }
    theme = DATA / "themes" / gtk_theme_name(flavor)
    (theme / "gtk-3.0").mkdir(parents=True, exist_ok=True)
    (theme / "index.theme").write_text(
        f"[Desktop Entry]\nType=X-GNOME-Metatheme\nName={gtk_theme_name(flavor)}\n"
        "Comment=generated by ~/.local/bin/theme\n")
    (theme / "gtk-3.0/gtk.css").write_text(
        f'/* generated by ~/.local/bin/theme */\n@import url("file://{base}");\n\n'
        + "".join(f"@define-color {k} {v};\n" for k, v in colors.items()))
    return True


def export(flavor, p):
    """Write the files that live outside $XDG_STATE_HOME/theme."""
    vscode(flavor)
    link(DUNST_DROPIN, CURRENT / "dunst.conf")
    link(YAZI_THEME, CURRENT / "yazi.toml")


def apply(flavor, p):
    export(flavor, p)
    run("dunstctl", "reload")
    dark = is_dark(p)
    run("gsettings", "set", "org.gnome.desktop.interface", "color-scheme", "prefer-dark" if dark else "prefer-light")
    fallback = "Adwaita-dark" if dark else "Adwaita"
    run("gsettings", "set", "org.gnome.desktop.interface", "icon-theme", ICON_THEME if icons(p) else "Adwaita")
    run("gsettings", "set", "org.gnome.desktop.interface", "gtk-theme",
        gtk_theme_name(flavor) if gtk(flavor, p) else fallback)
    run("pkill", "-USR1", "-x", "kitty")
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        run("hyprctl", "reload")


def main(args):
    cmd = args[0] if args else "current"
    flavors = sorted(f.stem for f in PALETTES.glob("*.json"))
    if cmd == "current":
        print(current())
    elif cmd == "list":
        print("\n".join(flavors))
    elif cmd == "init":
        flavor = current()
        export(flavor, write(flavor))
    elif cmd == "toggle":
        flavor = TOGGLE.get(current(), DEFAULT)
        apply(flavor, write(flavor))
    elif cmd in flavors:
        apply(cmd, write(cmd))
    elif cmd == "vscode-clean":
        # git clean filter: stdin -> stdout with the default theme
        sys.stdout.write(set_vscode_theme(sys.stdin.read(), DEFAULT))
    else:
        print(__doc__.strip().splitlines()[-1], file=sys.stderr)
        print("flavors: " + ", ".join(flavors), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
