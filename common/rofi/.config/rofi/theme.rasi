// generated by ~/.local/bin/theme
@import "~/.local/state/theme/current/colors.rasi"

* {
    background-color:  transparent;
    text-color:         @fg;
}

window {
    transparency:      "real";
    background-color:  @bg;
    border:             2px;
    border-color:       @accent;
    border-radius:      14px;
    width:              600px;
    location:           center;
    padding:            14px;
}

mainbox {
    children:  [ inputbar, listview ];
    spacing:    10px;
}

inputbar {
    background-color:  @bg-alt;
    border-radius:      10px;
    padding:            10px 14px;
    children:          [ prompt, entry ];
    spacing:            8px;
}

prompt {
    text-color:  @accent;
    font:        "Noto Sans Mono Bold 11";
}

entry {
    placeholder:        "Search...";
    placeholder-color:  @overlay;
    text-color:         @fg;
}

listview {
    lines:          8;
    spacing:        4px;
    scrollbar:      false;
    fixed-height:   false;
}

element {
    padding:        8px 10px;
    border-radius:  8px;
}

element normal.normal {
    text-color:  @fg;
}

element selected.normal {
    background-color:  @surface;
    text-color:         @accent;
}

element-icon {
    size:            22px;
    vertical-align:  0.5;
}

element-text {
    vertical-align:  0.5;
}
